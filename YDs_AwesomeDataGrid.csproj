<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net481</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<UseWindowsForms>true</UseWindowsForms>
	<Title>YDs AwesomeDataGrid</Title>
	<Description>Simple and faster custom DataGridView without third-party dependencies</Description>
	<PackageProjectUrl>https://yd359team.github.io/YDs-AwesomeDataGrid/</PackageProjectUrl>
	<RepositoryUrl>https://github.com/YD359Team/YDs-AwesomeDataGrid</RepositoryUrl>
	<PackageTags>winfroms, datagrid, datagridview, table</PackageTags>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<Authors>YDav359</Authors>
	<Company>YD359Team</Company>
	<Version>0.1.0</Version>
	<AssemblyVersion>0.1.0</AssemblyVersion>
	<FileVersion>0.1.0</FileVersion>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net481'">
   <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
